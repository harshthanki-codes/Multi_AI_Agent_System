# Application Configuration
APP_NAME=Multi-Agent AI Boardroom
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Default uses local SQLite. Can be set to postgresql+psycopg2://user:pass@localhost:5432/boardroom
DATABASE_URL=sqlite:///./boardroom.db

# LLM Provider Configuration
# Supported providers: "mock", "openai"
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Orchestration & Guardrails
DEFAULT_MAX_ROUNDS=2
MAX_ALLOWED_ROUNDS=5
MAX_TOPIC_LENGTH=500
MAX_AGENT_TOKENS=600
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
